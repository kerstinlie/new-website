---
import { navigation } from '../data/navigation';

interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;
const nav = navigation[lang];
const homeSlug = lang === 'de' ? 'startseite' : 'home';
const startTrialHref = lang === 'de' ? 'https://inbetween.com/de/start-free-trial/' : 'https://inbetween.com/en/start-free-trial/';
const requestDemoHref = 'https://calendly.com/inbetween-sales';
const startTrialLabel = lang === 'de' ? 'Kostenlos testen' : 'Start Free Trial';
const requestDemoLabel = lang === 'de' ? 'Demo anfragen' : 'Request Demo';

function hrefFor(node: { slug: string | null; href?: string | null }) {
  if (node.slug) return `/${node.slug}`;
  if (node.href) return node.href;
  return '#';
}
---
<header class="site-header">
  <div class="site-header__topbar">
    <div class="wrapper">
      {nav.top.map((item) => (
        <a href={hrefFor(item)}>{item.title}</a>
      ))}
    </div>
  </div>

  <div class="wrapper site-header__main">
    <a class="site-header__logo" href={`/${homeSlug}`} aria-label="InBetween Startseite">
      <img
        src="https://inbetween.com/wp-content/uploads/InBetween_Logo_colored_RGB-3-1.png"
        alt="InBetween"
        width="180"
        height="36"
      />
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation">
      {nav.main.map((item) => (
        <div class="site-nav__item">
          <a class="site-nav__link" href={hrefFor(item)}>{item.title}</a>
          {item.children && item.children.length > 0 && (
            <div class="site-nav__dropdown">
              {item.children.map((child) => (
                <>
                  <a href={hrefFor(child)}>{child.title}</a>
                  {child.children && child.children.map((grandchild) => (
                    <>
                      {/* Zwischenebenen ohne eigene Seite (z.B. "Automation",
                          "Publication Management") sind reine Gruppentitel und
                          sollen nicht als Link ins Leere zeigen. */}
                      {grandchild.slug || grandchild.href ? (
                        <a href={hrefFor(grandchild)} class="site-nav__dropdown-l2">{grandchild.title}</a>
                      ) : (
                        <span class="site-nav__dropdown-group">{grandchild.title}</span>
                      )}
                      {grandchild.children && grandchild.children.map((greatgrandchild) => (
                        <a href={hrefFor(greatgrandchild)} class="site-nav__dropdown-l3">{greatgrandchild.title}</a>
                      ))}
                    </>
                  ))}
                </>
              ))}
            </div>
          )}
        </div>
      ))}

      <div class="site-nav__lang">
        <a href="/home" aria-current={lang === 'en' ? 'true' : 'false'}>EN</a>
        <a href="/startseite" aria-current={lang === 'de' ? 'true' : 'false'}>DE</a>
      </div>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__btn site-header__btn--ghost" href={startTrialHref} target="_blank" rel="noopener noreferrer">{startTrialLabel}</a>
      <a class="site-header__btn" href={requestDemoHref} target="_blank" rel="noopener noreferrer">{requestDemoLabel}</a>
    </div>
  </div>
</header>
