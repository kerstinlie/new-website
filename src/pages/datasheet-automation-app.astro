<!-- is:inline ist hier zwingend: das Markup nutzt inline onclick-Handler
     (openModal/closeModal/...). Ohne is:inline wuerde Astro das Skript als
     ES-Modul buendeln, die Funktionen waeren dann nicht global und alle
     Klicks im Layout-Vergleich blieben wirkungslos. -->
<script is:inline>
const layouts = [
  {
    tag: 'Layout 1 of 4',
    title: 'Vertical — Image + Benefits + Specs',
    hint: 'Best for: Consumer electronics, B2C products, feature-rich items',
    img: '/images/datasheet/ds-b1f56e9d.jpg',
    structure: ['Logo & product title in header', 'Product image & benefit list', 'Certification badges row', 'Product description paragraph', 'Full-width specifications table', 'Branded footer with date'],
    usecases: ['Laptops & electronics', 'Consumer goods', 'Products with key selling points', 'B2C catalogs and retail sheets']
  },
  {
    tag: 'Layout 2 of 4',
    title: 'Horizontal — 3-Column Spec Sheet',
    hint: 'Best for: Technical products with many specification categories',
    img: '/images/datasheet/ds-4b90c983.jpg',
    structure: ['Full-width header with product name + logo', '3 equal columns for specification groups', 'Color-coded section headings', 'product image & certification badges row', 'Notes section in right column', 'footer bar'],
    usecases: ['Technical datasheets', 'Industrial equipment', 'Products with 20+ spec values', 'Landscape / A4 horizontal output']
  },
  {
    tag: 'Layout 3 of 4',
    title: 'Image-focused — Large Visual + Ratings',
    hint: 'Best for: Products where visual appearance and performance metrics matter',
    img: '/images/datasheet/ds-59e02aba.jpg',
    structure: ['Header with eyebrow + bold product name', 'Large product image (left column)', 'Certification badges below image', 'Performance rating bars', 'Key features table'],
    usecases: ['Automotive & tire products', 'Sports & outdoor equipment', 'Products with rated performance criteria', 'Technical + visual-heavy sheets']
  },
  {
    tag: 'Layout 4 of 4',
    title: 'Table-oriented — Product Family Overview',
    hint: 'Best for: Product families / variants with structured comparison data',
    img: '/images/datasheet/ds-293035b7.jpg',
    structure: ['Large bold product title at top', 'Product image (left) + meta info + sub-images (right)', 'CE / certification marks', 'Full-width multi-column data table', 'Alternating row colors for readability', 'Dark branded footer with company logo'],
    usecases: ['Product families with multiple variants', 'Industrial / B2B products', 'Items with part numbers and specs table', 'Pump, valve, machinery datasheets']
  }
];

let current = 0;

function openModal(index) {
  current = index;
  renderModal();
  document.getElementById('layout-modal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function closeModal() {
  document.getElementById('layout-modal').style.display = 'none';
  document.body.style.overflow = '';
}

function prevModal() { current = (current + 3) % 4; renderModal(); }
function nextModal() { current = (current + 1) % 4; renderModal(); }

function renderModal() {
  const l = layouts[current];
  document.getElementById('modal-tag').textContent = l.tag;
  document.getElementById('modal-title').textContent = l.title;
  document.getElementById('modal-hint').textContent = l.hint;
  document.getElementById('modal-img').src = l.img;
  document.getElementById('modal-img').alt = l.title;
  document.getElementById('modal-counter').textContent = (current + 1) + ' / 4';

  const mkList = (items, icon, color) => items.map(i =>
    `<li style="font-size:13px;font-weight:300;color:#313131;padding:6px 0;border-bottom:1px solid #e6dcc8;display:flex;gap:8px;line-height:1.4;">
      <span style="color:${color};font-weight:900;flex-shrink:0;">${icon}</span>${i}
    </li>`
  ).join('');

  document.getElementById('modal-info-left').innerHTML = `
    <div style="font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:0.08em;color:#d31145;margin-bottom:10px;">Structure</div>
    <ul style="list-style:none;padding:0;margin:0;">${mkList(l.structure, '→', '#d31145')}</ul>`;

  document.getElementById('modal-info-right').innerHTML = `
    <div style="font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:0.08em;color:#d31145;margin-bottom:10px;">Ideal use cases</div>
    <ul style="list-style:none;padding:0;margin:0;">${mkList(l.usecases, '✓', '#0f7b6c')}</ul>`;
}

document.addEventListener('keydown', function(e) {
  if (!document.getElementById('layout-modal').style.display || document.getElementById('layout-modal').style.display === 'none') return;
  if (e.key === 'Escape') closeModal();
  if (e.key === 'ArrowRight') nextModal();
  if (e.key === 'ArrowLeft') prevModal();
});
</script>
