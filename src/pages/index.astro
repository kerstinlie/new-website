---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageBySlug } from '../lib/sanity';

// Startseite = die migrierte WordPress-Seite mit Slug "home" (EN-Standard)
const page = await getPageBySlug('home');

if (page) {
  return Astro.redirect('/home');
}
---
<BaseLayout title="InBetween" description="InBetween – Next Level Publishing" lang="en">
  <div class="wrapper" style="padding-top: 2rem; padding-bottom: 3rem;">
    <h1>InBetween</h1>
    <p>Die Startseite konnte nicht geladen werden. <a href="/blog">Zum Blog →</a></p>
  </div>
</BaseLayout>
