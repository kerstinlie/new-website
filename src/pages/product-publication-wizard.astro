<BaseLayout
  title="Publication Wizard"
  description="The Publication Wizard PRO - your solution for the generation of partially automated publications."
  lang="en"
>
  <link rel="stylesheet" href="/legacy/publication-wizard.css" />
  <div class="elementor-kit-8 legacy-page" set:html={inhalt} />

  <!-- Das Bildkarussell ist das einzige Element der Seite, das JavaScript
       braucht. Elementor nutzt dafuer Swiper - dieselbe Bibliothek laesst
       sich direkt einbinden, statt Elementors Frontend-JS mitzuschleppen
       (das haengt an jQuery und globalen Konfigurationsobjekten).
       Version 8.4.5 passend zur bereits gebuendelten swiper.min.css. -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/8.4.5/swiper-bundle.min.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof Swiper === 'undefined') return;
      document.querySelectorAll('.elementor-widget-image-carousel').forEach(function (widget) {
        var el = widget.querySelector('.swiper');
        if (!el) return;

        // Elementor legt seine Widget-Konfiguration als JSON im Markup ab.
        var cfg = {};
        try {
          cfg = JSON.parse(widget.getAttribute('data-settings') || '{}');
        } catch (e) {
          cfg = {};
        }

        new Swiper(el, {
          slidesPerView: Number(cfg.slides_to_show) || 1,
          loop: cfg.infinite === 'yes',
          speed: Number(cfg.speed) || 500,
          effect: cfg.effect === 'fade' ? 'fade' : 'slide',
          autoplay:
            cfg.autoplay === 'yes'
              ? {
                  delay: Number(cfg.autoplay_speed) || 4000,
                  pauseOnMouseEnter: cfg.pause_on_hover === 'yes',
                  disableOnInteraction: cfg.pause_on_interaction === 'yes',
                }
              : false,
          pagination: { el: widget.querySelector('.swiper-pagination'), clickable: true },
          navigation: {
            nextEl: widget.querySelector('.elementor-swiper-button-next'),
            prevEl: widget.querySelector('.elementor-swiper-button-prev'),
          },
        });
      });
    });
  </script>
</BaseLayout>

<style is:global>
  /* Der Port bringt seine eigenen Abstaende mit - unsere Artikel-Regeln
     duerfen hier nicht dazwischenfunken. */
  .legacy-page p {
    margin-block: 0;
  }
  .legacy-page img {
    display: inline-block;
  }
</style>
