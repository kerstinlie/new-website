---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Vielen Dank" description="Ihre Anfrage wurde übermittelt.">
  <div class="wrapper form-thanks">
    <h1>Vielen Dank!</h1>
    <p id="form-thanks-text">Ihre Anfrage ist bei uns eingegangen.</p>
    <a id="form-thanks-link" class="pt-cta-btn" href="#" target="_blank" rel="noopener" hidden>→ Weiter</a>
  </div>
</BaseLayout>

<style>
  .form-thanks {
    padding: 4rem 1.5rem;
    text-align: center;
    max-width: 560px;
  }
  .form-thanks h1 {
    margin-bottom: 1rem;
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const redirect = params.get('redirect');
  const message = params.get('message');
  const text = document.getElementById('form-thanks-text');
  const link = document.getElementById('form-thanks-link') as HTMLAnchorElement | null;

  if (redirect && link) {
    if (text) text.textContent = 'Ihr Inhalt ist bereit:';
    link.href = redirect;
    link.hidden = false;
    // Automatisch oeffnen (PDF-Download, Video, Termin-Buchung); der Button
    // bleibt als manueller Fallback sichtbar, falls der Browser das Popup
    // blockiert.
    window.open(redirect, '_blank');
  } else if (message && text) {
    text.textContent = message;
  }
</script>
