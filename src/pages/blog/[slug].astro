---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getPostBySlug, urlFor } from '../../lib/sanity';
import PortableTextBody from '../../components/PortableTextBody';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug.current },
  }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug as string);

if (!post) {
  return Astro.redirect('/404');
}

// Manche Beitraege (Success Stories, aber auch einzelne News/Webinar-
// Artikel) sind komplett eigens mit Elementor gestaltete Seiten mit einem
// farbig hinterlegten Hero-Band ganz oben im body (Logo/Ueberschrift/Bild
// vor Farbverlauf). Der generische Blog-Artikel-Kopf (Titelbild + H1 +
// Autor/Datum/Kategorie-Zeile) kam im WordPress-Original dafuer NICHT vor
// (die Ueberschrift steckt schon im Hero-Band) und wuerde nur doppelt wirken.
const firstBlock = (post.body || [])[0];
const isCustomStoryLayout = firstBlock?._type === 'columns' && !!firstBlock?.heroBand;
// post.language ist (anders als bei Seiten) noch nicht gepflegt - deutsche
// Beitraege sind aber durchgaengig am "-de"-Slug-Suffix erkennbar.
const lang = post.language || (post.slug?.current?.endsWith('-de') ? 'de' : 'en');
---
<BaseLayout
  title={post.seo?.metaTitle || post.title}
  description={post.seo?.metaDescription || post.excerpt}
  lang={lang}
>
  {isCustomStoryLayout ? (
    <div class="wrapper" style="padding-top: 0; padding-bottom: 3rem;">
      <article>
        <PortableTextBody value={post.body} language={lang} client:load />
      </article>
    </div>
  ) : (
    <div class="wrapper" style="padding-top: 2rem; padding-bottom: 3rem; max-width: 760px;">
      {post.mainImage && (
        <img src={urlFor(post.mainImage).width(1200).url()} alt={post.title} style="border-radius: 8px; margin-bottom: 1.5rem;" />
      )}
      <h1>{post.title}</h1>
      <p style="color: var(--color-text-muted); font-size: 0.9rem;">
        {post.author && <span>{post.author}</span>}
        {post.publishedAt && <time datetime={post.publishedAt}> · {new Date(post.publishedAt).toLocaleDateString('de-DE')}</time>}
        {post.categories && post.categories.length > 0 && (
          <span> — {post.categories.join(', ')}</span>
        )}
      </p>
      <article>
        <PortableTextBody value={post.body} language={lang} client:load />
      </article>
    </div>
  )}
</BaseLayout>
