---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPages, getPageBySlug, getPostsByCategory, POST_LIST_PAGES, urlFor } from '../lib/sanity';
import PortableTextBody from '../components/PortableTextBody';
import PostGrid from '../components/PostGrid.astro';
import HomeHero from '../components/HomeHero';

export async function getStaticPaths() {
  const pages = await getAllPages();
  return pages.map((page) => ({
    params: { slug: page.slug.current },
  }));
}

const { slug } = Astro.params;
const page = await getPageBySlug(slug as string);

if (!page) {
  return Astro.redirect('/404');
}

const lang = page.language || 'en';

// Seiten, die in WordPress ein dynamisches "Posts"-Widget genutzt haben
// (z.B. Success Stories, News, Webinare) -> hier live aus den migrierten
// Blog-Beitraegen nachbauen, statt sie leer zu lassen.
const postListCategories = POST_LIST_PAGES[slug as string];
const listedPosts = postListCategories ? await getPostsByCategory(postListCategories) : null;

// Home/Startseite bekommen einen eigens gebauten Hero-Bereich (Hintergrund,
// grosse Ueberschrift, echter Bild-Slider) statt der generischen Darstellung,
// weil der Original-Hero in WordPress ein Slider mit besonderem Sektions-
// Styling ist, das sich nicht generisch aus dem migrierten Inhalt ableiten laesst.
const isHomeHero = slug === 'home' || slug === 'startseite';
let heroHeadingBlock: any = null;
let heroTextBlocks: any[] = [];
let heroSlides: any[] = [];
let restBody = page.body || [];

// Seiten mit eigenem farbig hinterlegtem Hero-Band ganz oben (Logo/
// Ueberschrift/Bild vor Farbverlauf, z.B. Produktseiten/Free-Trial) haben
// die Ueberschrift schon im Hero-Band selbst - der generische Titel/Bild-
// Kopf darueber waere doppelt und kam im WordPress-Original so nicht vor.
const hasOwnHeroBand = !isHomeHero && page.body?.[0]?._type === 'columns' && !!page.body?.[0]?.heroBand;

if (
  isHomeHero &&
  Array.isArray(page.body) &&
  page.body.length >= 2 &&
  page.body[0]?._type === 'block' &&
  page.body[1]?._type === 'columns'
) {
  heroHeadingBlock = page.body[0];
  const cols = page.body[1].columns || [];
  heroTextBlocks = cols[0]?.blocks || [];
  const visualBlocks = cols[1]?.blocks || [];
  const slidesBlock = visualBlocks.find((b: any) => b._type === 'heroSlides');
  if (slidesBlock) {
    heroSlides = slidesBlock.slides || [];
  } else {
    // Fallback, falls kein heroSlides-Block gefunden wurde: einzelne Bilder
    // als "Folien" ohne Text-Overlay behandeln.
    heroSlides = visualBlocks
      .filter((b: any) => b._type === 'image')
      .map((b: any) => ({ _key: b._key, image: b }));
  }
  restBody = page.body.slice(2);
}

// Die "+++ NEWS +++"-Sektion kam aus einem dynamischen WordPress-Posts-
// Widget, das die Migration nicht automatisch uebernehmen konnte (es fragt
// live WP-Daten ab, keine statischen Inhalte). Hier wird an dieser Stelle
// im Body eine echte Vorschau der neuesten News-Beitraege eingefuegt, statt
// die Sektion leer zu lassen.
let newsBeforeBody: any[] | null = null;
let newsAfterBody: any[] | null = null;
let newsPreviewPosts: Awaited<ReturnType<typeof getPostsByCategory>> = [];
if (isHomeHero) {
  const newsIdx = restBody.findIndex(
    (b: any) => b?._type === 'block' && (b.children || []).some((c: any) => (c.text || '').includes('+++'))
  );
  if (newsIdx !== -1) {
    const newsCategories = lang === 'de' ? ['Neuigkeiten'] : ['News'];
    newsPreviewPosts = (await getPostsByCategory(newsCategories)).slice(0, 3);
    // Heading + direkt folgender "more news"-Link (falls vorhanden) bleiben
    // vor der Vorschau, der restliche Inhalt kommt danach.
    let splitAt = newsIdx + 1;
    if (restBody[splitAt]?._type === 'block' && (restBody[splitAt].children || []).length === 1) {
      splitAt += 1;
    }
    newsBeforeBody = restBody.slice(0, splitAt);
    newsAfterBody = restBody.slice(splitAt);
  }
}
---
<BaseLayout
  title={page.seo?.metaTitle || page.title}
  description={page.seo?.metaDescription}
  lang={lang}
>
  {isHomeHero && heroHeadingBlock ? (
    <>
      <HomeHero headingBlock={heroHeadingBlock} textBlocks={heroTextBlocks} slides={heroSlides} client:load />
      <div class="wrapper" style="padding-top: 2.5rem; padding-bottom: 3rem;">
        <article>
          {newsBeforeBody ? (
            <>
              <PortableTextBody value={newsBeforeBody} client:load />
              {newsPreviewPosts.length > 0 && <PostGrid posts={newsPreviewPosts} />}
              <PortableTextBody value={newsAfterBody} client:load />
            </>
          ) : (
            <PortableTextBody value={restBody} client:load />
          )}
        </article>
        {listedPosts && <PostGrid posts={listedPosts} />}
      </div>
    </>
  ) : hasOwnHeroBand ? (
    <div class="wrapper" style="padding-top: 0; padding-bottom: 3rem;">
      <article>
        <PortableTextBody value={page.body} client:load />
      </article>
      {listedPosts && <PostGrid posts={listedPosts} />}
    </div>
  ) : (
    <div class="wrapper" style="padding-top: 2rem; padding-bottom: 3rem;">
      {page.heroImage && (
        <img src={urlFor(page.heroImage).width(1200).url()} alt={page.title} style="margin-bottom: 1.5rem; border-radius: 8px;" />
      )}
      <h1>{page.title}</h1>
      <article>
        <PortableTextBody value={page.body} client:load />
      </article>
      {listedPosts && <PostGrid posts={listedPosts} />}
    </div>
  )}
</BaseLayout>
