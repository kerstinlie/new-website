# Sanity-Projekt-ID und Dataset (findest du im Sanity-Dashboard bzw. bekommst du
# beim Anlegen des Projekts über den Sanity-MCP-Connector).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Token mit Schreibrechten – nur nötig für Migrations-/Import-Skripte,
# NICHT ins Frontend/Client-Bundle einbinden, NICHT committen.
SANITY_API_WRITE_TOKEN=
